// ===== PART 5 of 5 - J.U.S.T.I.N. v13 WAKE-WORD PACK =====
// Paste at the VERY BOTTOM, below Part 4.
// IMPORTANT: this is NOT the openWakeWord neural pipeline. It hardens the phone's speech-to-text
// wake loop (text-level checks: repeat-before-trigger, 1.2 s cooldown, sound-alike filtering).
// The real pipeline (mel -> 96-d embeddings -> classifier -> patience/debounce) is the Android helper in
// justin-wake.zip. When that helper is running it sends "justin.WAKE", which the receiver below handles.
// Say "wake word off" while the helper runs, so two listeners don't fight over the mic.

function wakeChime(){
  if(!store.get("wake_chime",true))return;
  try{device.vibrate(40)}catch(e){}
  try{
    var tg=new android.media.ToneGenerator(3,50);
    tg.startTone(android.media.ToneGenerator.TONE_PROP_ACK,140);
    setTimeout(function(){try{tg.release()}catch(e){}},400)
  }catch(e){}
}

// Returns {hit, rest, strong}. strong = said "hey/ok justin" (high confidence)
function wakeMatch(e){
  var t=String(e).toLowerCase().replace(/[^a-z0-9' ]/g," ").replace(/\s+/g," ").trim();
  var NAMES="justin|justine|justen|justan|jostin|justing|just in|jus tin";
  var m=t.match(new RegExp("^(?:(hey|hay|hi|ok|okay|yo|hello)\\s+)?("+NAMES+")\\b\\s*(.*)$"));
  var prefixed=!!(m&&m[1]);
  if(!m){
    m=t.match(new RegExp("\\b(hey|hay|ok|okay)\\s+("+NAMES+")\\b\\s*(.*)$"));
    prefixed=!!m
  }
  if(!m)return{hit:false};
  var variant=m[2],rest=(m[3]||"").trim();
  // adversarial negatives
  if(variant==="just in"||variant==="jus tin"){
    if(!prefixed)return{hit:false};
    if(/^(time|case|a|an|the|about|for|like|as|between|one|two|three|\d)\b/.test(rest))return{hit:false}
  }
  if(!prefixed){
    // bare "Justin ..." only counts if it is alone or sounds like a command/question
    var cmdLike=CMD_START.test(rest)||/^(what|what's|whats|who|when|where|why|how|can|could|will|would|is|are|do|does|tell|show|give|read|remind|play)\b/.test(rest);
    if(rest&&!cmdLike)return{hit:false}
  }
  return{hit:true,rest:rest,strong:prefixed}
}

function earPartial(e){
  if(!e)return;
  ear.errs=0;
  if(ear.mode==="dictate"){
    ear.partial=e;ear.lastVoice=Date.now();
    try{wBot&&wBot.input.setText((ear.text+" "+e).trim())}catch(i){}
    return
  }
  var t=wakeMatch(e);
  if(t.hit){
    if(Date.now()-(ear.lastWake||0)<1200)return;          // debounce
    if(t.rest){ear.rest=t.rest;return}                      // wait for the final text with the full command
    ear.hits=(ear.hits||0)+1;
    if(t.strong||ear.hits>=2){                              // patience for weak (bare-name) matches
      ear.hits=0;ear.lastWake=Date.now();
      wakeChime();
      earEnterDictate("",false)
    }
    return
  }
  ear.hits=0;
  if(ear.mode==="speaking"){
    var n=earUser(e);
    if(n.stop){stopTts();return}
    if(n.user){earEnterDictate("",false);ear.partial=e}
  }
}

function earFinal(e){
  ear.errs=0;
  if(ear.mode==="dictate"){
    var t=wakeMatch(e),n=t.hit?t.rest:e;
    if(n){ear.text=(ear.text+" "+n).trim();ear.lastVoice=Date.now()-300}
    ear.partial="";
    try{wBot&&wBot.input.setText(ear.text)}catch(o){}
    earRestart(150);
    return
  }
  var i=wakeMatch(e);
  if(i.hit){
    if(Date.now()-(ear.lastWake||0)<1200){earRestart(150);return}   // debounce
    var r=(i.rest||ear.rest||"").trim();
    ear.hits=0;ear.rest="";ear.lastWake=Date.now();
    if(r){
      try{device.vibrate(30)}catch(x){}
      stopTts();afterDictateSend(r);return
    }
    wakeChime();
    earEnterDictate("",false);
    earRestart(150);
    return
  }
  ear.hits=0;ear.rest="";
  if(ear.mode==="speaking"){
    var a=earUser(e);
    if(a.stop){stopTts();earRestart(150);return}
    if(a.user){
      earEnterDictate(String(e),false);
      ear.text=String(e);ear.lastVoice=Date.now()-300;
      earRestart(150);
      return
    }
  }
  earRestart(120)
}

// ---- External engine hook: Termux/Kotlin/Tasker running a real openWakeWord model can send
//      adb/am:  am broadcast -a justin.WAKE --package <AutoX package name>
var wakeRecv=null;
function registerWakeReceiver(){
  if(wakeRecv)return;
  try{
    wakeRecv=new android.content.BroadcastReceiver({
      onReceive:function(){
        threads.start(function(){
          if(Date.now()-(ear.lastWake||0)<1200)return;
          ear.lastWake=Date.now();
          wakeChime();
          if(ear.mode!=="dictate")earBegin("dictate","")
        })
      }
    });
    var f=new android.content.IntentFilter("justin.WAKE");
    if(android.os.Build.VERSION.SDK_INT>=33)context.registerReceiver(wakeRecv,f,2);
    else context.registerReceiver(wakeRecv,f)
  }catch(e){log("wake receiver: "+e);wakeRecv=null}
}
registerWakeReceiver();
events.on("exit",function(){try{wakeRecv&&context.unregisterReceiver(wakeRecv)}catch(e){}});

// ---- Battery guard for always-listening
setInterval(function(){
  try{
    if(!ear.want)return;
    var b=device.getBattery();
    if(b>=0&&b<15&&!device.isCharging()){
      store.put("wake_word",false);
      ear.want=false;
      earIdle();
      addBubble("ai","Battery is under 15%, so I turned off always-listening to save power. Say 'wake word on' once you've charged.")
    }
  }catch(e){}
},60000);
// ===== END OF PART 5 =====
