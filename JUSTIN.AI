      if(wBot){
        setIcon(wBot.icSend,"send",e,24);
        setIcon(wBot.icLead,"image",e,22);
        setIcon(wBot.icMic,"mic",listening?"#FF4D4D":e,24);
        wBot.icSend.setContentDescription("Send message");
        wBot.icLead.setContentDescription("Assistant icon");
        wBot.icMic.setContentDescription("Speak to the assistant")
      }
      wSb&&wSb.sbTitle.setTextColor(t)
    }catch(n){}
  })
}
function a11yCommands(e){
  var t=String(e).toLowerCase().trim().replace(/[.!?]+$/,""),n;
  if(n=t.match(/^(?:accessibility|screen reader|easy)\s+mode\s+(on|off)$/)){
    var on=n[1]==="on";
    store.put("high_contrast",on);store.put("text_scale",on?1.3:1);store.put("voice_on",on);
    if(!on)try{tts&&tts.stop()}catch(x){}
    return on?"Accessibility mode on: larger text, high contrast and spoken replies for new messages. Say 'accessibility mode off' to undo.":"Accessibility mode off."
  }
  if(n=t.match(/^text\s+size\s+(small|normal|large|huge)$/)){
    store.put("text_scale",{small:.85,normal:1,large:1.25,huge:1.5}[n[1]]);
    return"Text size set to "+n[1]+" for new messages."
  }
  if(n=t.match(/^high\s+contrast\s+(on|off)$/)){
    store.put("high_contrast",n[1]==="on");
    return"High contrast "+n[1]+" for new messages."
  }
  if(n=t.match(/^(allow|block)\s+sensitive\s+apps?$/)){
    store.put("allow_sensitive",n[1]==="allow");
    return n[1]==="allow"?"Okay. I may now read screens in banking, wallet and password apps. Say 'block sensitive apps' to turn protection back on.":"Protection on: I won't look at banking, wallet or password apps."
  }
  if(/^(?:read|speak)\s+(?:that|it|last reply|the last reply)(?:\s+aloud)?$/.test(t)){
    for(var a=history.length-1;a>=0;a--){
      if(history[a].who==="ai"){
        var prev=store.get("voice_on",false);
        store.put("voice_on",true);
        speak(history[a].text);
        store.put("voice_on",prev);
        return"Reading it aloud."
      }
    }
    return"Nothing to read yet."
  }
  return null
}
function processMessage(e){
  statusShow("JUSTIN \xB7 working\u2026");
  try{
    var t=session();
    if(!(t&&t.email===ADMIN_EMAIL)){
      var n=harmCheck(e);
      if(n){
        var i=logHarm(n,e);
        addBubble("ai","Security restriction: I can't provide instructions for bypassing authentication, authorization, access controls, or security monitoring. This interaction may be logged for security review. (strike "+i+"/3)");
        if(i>=3){addBubble("ai","Account blocked due to repeated policy violations.");signOut()}
        return
      }
    }
    if(pendingAsk){
      var r=pendingAsk;
      pendingAsk=null;
      if(Date.now()-r.t<6e5&&!/^(stop|cancel)$/i.test(e)){
        runAgent(r.goal+' (You asked the user: "'+r.q+'" and they answered: "'+e+'")',null);
        return
      }
    }
    if(teaching){
      var a=e.toLowerCase().trim();
      if(/^(?:done|finish|end|save)(?:\s+teaching)?$/.test(a)||a==="stop teaching"){finishTeaching();return}
      if(/^(?:cancel|abort)\s+teaching$/.test(a)){teaching=null;addBubble("ai","Teaching cancelled.");return}
      teaching.steps.push(e);
      addBubble("ai","Step "+teaching.steps.length+" saved. Next step, or say 'done teaching'.",["done teaching"]);
      return
    }
    var ax=a11yCommands(e);
    if(ax){addBubble("ai",ax);return}
    brief=/\b(brief|tldr)\b/i.test(e);
    var o=handleLocal(e);
    if(o&&o.response===null)return;
    if(!o){
      if(!allowAI())return;
      showTyping();
      statusShow("JUSTIN \xB7 thinking\u2026");
      o=generateAI(e);
      hideTyping();
      countUse()
    }
    addBubble("ai",whisper?o.response.toLowerCase():o.response,o.suggestions);
    o.todo?runAgent(o.todo,store.get("guide:"+normName(o.todo),null)):convoListen(o.response)
  }catch(s){hideTyping();addBubble("ai","Error: "+s)}
  finally{statusHide()}
}

// ---------- Settings panel: adds High contrast, Protect sensitive apps, Text size ----------
function buildSettings(){
  var e=inflateBody(TPL_SET);
  var t=[
    {label:"High contrast",get:function(){return hc()},set:function(s){store.put("high_contrast",s)}},
    {label:"Protect banking & password apps",get:function(){return !store.get("allow_sensitive",false)},set:function(s){store.put("allow_sensitive",!s)}},
    {label:"Voice replies",get:function(){return !!store.get("voice_on",false)},set:function(s){store.put("voice_on",s);if(!s)try{tts&&tts.stop()}catch(u){}}},
    {label:"Instant shortcuts",get:function(){return !store.get("shortcuts_off",false)},set:function(s){store.put("shortcuts_off",!s)}},
    {label:"Fast agent (fewer screenshots)",get:function(){return !!store.get("agent_fast",false)},set:function(s){store.put("agent_fast",s)}},
    {label:"Incognito (don't save chat)",get:function(){return incognito},set:function(s){incognito=s;if(s)try{store.remove("chat_hist")}catch(u){}}},
    {label:"Hands-free (listen after reply)",get:function(){return !!store.get("convo",false)},set:function(s){store.put("convo",s)}},
    {label:"Always listen for \u201CHey JUSTIN\u201D",get:function(){return !!store.get("wake_word",false)},set:function(s){store.put("wake_word",s);threads.start(function(){earWake(s)})}},
    {label:"Let me interrupt JUSTIN",get:function(){return !!store.get("barge_in",true)},set:function(s){store.put("barge_in",s)}},
    {label:"Confirm risky actions",get:function(){return !!store.get("confirm_risky",true)},set:function(s){store.put("confirm_risky",s)}},
    {label:"Shake to stop a task",get:function(){return !!store.get("shake_stop",true)},set:function(s){store.put("shake_stop",s)}},
    {label:"Quick-launch notification",get:function(){return !!store.get("quick_launch",false)},set:function(s){store.put("quick_launch",s);threads.start(function(){quickLaunch(s)})}}
  ];
  t.forEach(function(s){
    var u=ui.inflate(TPL_TROW,e.stToggles,false);
    u.tl.setText(s.label);
    function c(){var l=s.get();u.tv.setText(l?"ON":"OFF");styleBtn(u.tv,l?"green":"red")}
    c();
    u.tv.click(function(){s.set(!s.get());c()});
    e.stToggles.addView(u)
  });
  // text size chips
  var lbl=ui.inflate('<text text="TEXT SIZE (NEW MESSAGES)" textSize="11sp" textColor="#5a6a7a" margin="0 14 0 8" />',e.stToggles,false);
  e.stToggles.addView(lbl);
  var szRow=ui.inflate(TPL_ROW,e.stToggles,false),szChips=[];
  function paintSz(){szChips.forEach(function(s){var on=Math.abs(fs()-s.v)<.01;s.c.setBackground(shape(on?"#0B2A35":"#0f141a",on?accent:"#232a33",6));s.c.setTextColor(col(on?accent:"#8B949E"))})}
  [["A\u2212",.85],["A",1],["A+",1.25],["A++",1.5]].forEach(function(s){
    var c=mkChip(szRow,s[0],function(){store.put("text_scale",s[1]);paintSz()},6);
    szChips.push({v:s[1],c:c});
    szRow.addView(c)
  });
  e.stToggles.addView(szRow);paintSz();
  // agent model chips
  var n=[],i=ui.inflate(TPL_ROW,e.stModels,false);
  function r(){n.forEach(function(s){var u=agentModel()===s.id;s.v.setBackground(shape(u?"#0B2A35":"#0f141a",u?accent:"#232a33",6));s.v.setTextColor(col(u?accent:"#8B949E"))})}
  [["GPT-4O (BEST)","openai/gpt-4o"],["GPT-4O MINI (CHEAP)","openai/gpt-4o-mini"]].forEach(function(s){
    var u=mkChip(i,s[0],function(){store.put("model_agent",s[1]);r()},6);
    n.push({id:s[1],v:u});
    i.addView(u)
  });
  e.stModels.addView(i);r();
  // accent colours
  var a=[];
  function o(){a.forEach(function(s){s.v.setBackground(shape(s.c,String(s.c).toLowerCase()===String(accent).toLowerCase()?"#FFFFFF":null,17))})}
  ["#00E5FF","#4CE082","#FFA726","#FF4DFF","#4DA3FF","#FF6B6B"].forEach(function(s){
    var u=ui.inflate(TPL_SWATCH,e.stColors,false);
    a.push({c:s,v:u});
    u.click(function(){applyAccent(s);o()});
    e.stColors.addView(u)
  });
  o();
  e.stInfo.setText("Chat model: "+aiModel()+"\nVision model: "+visModel()+"\nSay 'diagnose' for a full check.")
}
